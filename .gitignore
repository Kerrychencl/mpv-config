# Large binaries exceeding GitHub limits
*.exe
*.dll
*.old

# Sensitive user credentials and dynamic cache
*cookies*
portable_config/cookies.txt
portable_config/cache/
portable_config/watch_later/
portable_config/sponsorblock_shared/*
!portable_config/sponsorblock_shared/sponsor_unified.py
portable_config/file_browser-last_opened_directory
url-scheme-handler/config.json

# Danmaku cache files
*.danmaku.xml
portable_config/scripts/mpv-danmaku/*.xml

# Temporary files, agent metadata, and python cache
.agents/
__pycache__/
*.pyc
*.part
*.tmp
*.log
prove-it/screenshots/
prove-it/*.log
prove-it/*_debug.log
prove-it/settled_test.log
*.bgra
mpv_btr_port*.txt

# Portable Python runtime
python/
